# Kakao Developers (kapi.kakao.com) - "카카오톡 메시지 API" 앱 REST API 키
KAKAO_REST_API_KEY=
# setup_kakao_auth.py 실행 후 발급받은 refresh_token
KAKAO_REFRESH_TOKEN=

# FRED API (https://fred.stlouisfed.org/docs/api/api_key.html, 무료 발급)
FRED_API_KEY=

# Google AI Studio Gemini API 무료 키 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# GitHub Personal Access Token (repo secrets 쓰기 권한) - refresh_token 회전 시 자동 갱신용
GH_PAT=
# owner/repo 형식 (예: myid/일일시황_카톡)
GH_REPO=
